# Copy to .env or set these in PowerShell before starting the backend.
# DATABASE_URL=sqlite:///./cybershield.db
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set ADMIN_TOKEN to require an X-Admin-Token header for training when the API is reachable beyond localhost.
# ADMIN_TOKEN=change-me
# MAX_UPLOAD_MB=5
# MAX_CSV_ROWS=5000
# Demonstration risk bands (0-100). Validate against real data before operational use.
# RISK_LOW_MAX=34
# RISK_MODERATE_MAX=64
